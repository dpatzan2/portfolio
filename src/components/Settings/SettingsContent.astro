<div class="settings-app h-full flex -m-5">
  <!-- Sidebar -->
  <aside class="w-44 shrink-0 border-r border-white/10 bg-white/5 py-3">
    <button class="settings-nav active" data-panel="appearance">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
      Apariencia
    </button>
    <button class="settings-nav" data-panel="about">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      Acerca de
    </button>
  </aside>

  <!-- Panels -->
  <main class="flex-1 overflow-y-auto p-6">
    <!-- Apariencia -->
    <section id="panel-appearance" class="settings-panel">
      <h2 class="text-lg font-medium mb-4">Estilo</h2>
      <div class="flex gap-4 mb-8">
        <button class="theme-option" data-theme="dark">
          <div class="w-32 h-20 rounded-lg border-2 overflow-hidden bg-[#2c2c2c]">
            <div class="h-4 bg-[#1a1a1a] flex items-center gap-1 px-2">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
            </div>
            <div class="p-2">
              <div class="w-16 h-1.5 bg-white/30 rounded mb-1.5"></div>
              <div class="w-20 h-1.5 bg-white/15 rounded"></div>
            </div>
          </div>
          <span class="block text-center text-sm mt-2">Oscuro</span>
        </button>
        <button class="theme-option" data-theme="light">
          <div class="w-32 h-20 rounded-lg border-2 overflow-hidden bg-[#fafafa]">
            <div class="h-4 bg-[#e0e0e0] flex items-center gap-1 px-2">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
            </div>
            <div class="p-2">
              <div class="w-16 h-1.5 bg-black/30 rounded mb-1.5"></div>
              <div class="w-20 h-1.5 bg-black/15 rounded"></div>
            </div>
          </div>
          <span class="block text-center text-sm mt-2">Claro</span>
        </button>
      </div>

      <h2 class="text-lg font-medium mb-4">Fondo de pantalla</h2>
      <div id="wallpaper-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-md">
        <!-- Se llena por JS desde desktopSettings.wallpapers -->
      </div>
    </section>

    <!-- Acerca de -->
    <section id="panel-about" class="settings-panel hidden">
      <div class="flex flex-col items-center text-center mb-8">
        <img src="/assets/logo.png" alt="Logo" class="w-20 h-20 object-contain mb-3" />
        <h2 class="text-xl font-medium">Portfolio OS</h2>
        <p class="text-sm opacity-60">24.04 LTS (Astro Jellyfish)</p>
      </div>
      <div class="max-w-md mx-auto divide-y divide-white/10 text-sm">
        <div class="about-row"><span>Nombre del equipo</span><span>portfolio-de-diego</span></div>
        <div class="about-row"><span>Procesador</span><span>Diego Patzán™ @ 4.0 GHz</span></div>
        <div class="about-row"><span>Memoria</span><span>∞ de ideas</span></div>
        <div class="about-row"><span>Gráficos</span><span>TailwindCSS / CSS3</span></div>
        <div class="about-row"><span>Almacenamiento</span><span>Lleno de proyectos</span></div>
        <div class="about-row"><span>Sistema operativo</span><span>Portfolio OS 24.04 LTS</span></div>
        <div class="about-row"><span>Sistema de ventanas</span><span>Window manager propio</span></div>
      </div>
      <div class="text-center mt-8">
        <a
          href="https://github.com/dpatzan2"
          target="_blank"
          class="inline-block px-4 py-2 bg-ubuntu-orange hover:bg-ubuntu-orange/80 text-white rounded-lg text-sm transition-colors"
        >
          Ver código en GitHub
        </a>
      </div>
    </section>
  </main>
</div>

<style>
  .settings-nav {
    @apply w-full flex items-center gap-2 px-4 py-2 text-left text-sm hover:bg-white/10 transition-colors;
  }

  .settings-nav.active {
    @apply bg-ubuntu-orange/80 text-white;
  }

  .theme-option > div {
    border-color: transparent;
    transition: border-color 0.15s ease;
  }

  .theme-option.selected > div {
    border-color: #e95420;
  }

  .about-row {
    @apply flex justify-between py-2.5 gap-4;
  }

  .about-row span:first-child {
    @apply opacity-60;
  }

</style>

<!-- Global: los swatches se crean por JS y no reciben el scope de Astro -->
<style is:global>
  .wallpaper-swatch {
    aspect-ratio: 16 / 10;
    border-radius: 0.5rem;
    border: 2px solid transparent;
    cursor: pointer;
    background-size: cover;
    background-position: center;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .wallpaper-swatch:hover {
    transform: scale(1.03);
  }

  .wallpaper-swatch.selected {
    border-color: #e95420;
  }
</style>

<script>
  // API global de apariencia: la usan Configuración, quick settings y el menú contextual
  const wallpapers: Record<string, string> = {
    jammy: "url('/assets/ubuntu-bg.jpg') center / cover",
    noble: "linear-gradient(135deg, #772953 0%, #b34324 55%, #E95420 100%)",
    lunar: "linear-gradient(135deg, #0f1c3f 0%, #24427c 60%, #2c5364 100%)",
    forest: "linear-gradient(135deg, #134e5e 0%, #71b280 100%)",
    mate: "linear-gradient(160deg, #2c001e 0%, #5e2750 60%, #77216f 100%)",
    grafito: "radial-gradient(circle at 30% 30%, #3a3a3a 0%, #101010 100%)",
  };

  function applyWallpaper(id: string) {
    const desktop = document.getElementById("desktop");
    if (desktop && wallpapers[id]) desktop.style.background = wallpapers[id];
    document
      .querySelectorAll(".wallpaper-swatch")
      .forEach((s) =>
        s.classList.toggle("selected", (s as HTMLElement).dataset.wallpaper === id),
      );
  }

  function markTheme(theme: string) {
    document
      .querySelectorAll(".theme-option")
      .forEach((b) =>
        b.classList.toggle("selected", (b as HTMLElement).dataset.theme === theme),
      );
  }

  const desktopSettings = {
    wallpapers,
    setTheme(theme: "light" | "dark") {
      document.documentElement.classList.toggle("light", theme === "light");
      localStorage.setItem("portfolio-theme", theme);
      markTheme(theme);
      document.dispatchEvent(new CustomEvent("theme-changed", { detail: theme }));
    },
    getTheme(): "light" | "dark" {
      return document.documentElement.classList.contains("light") ? "light" : "dark";
    },
    setWallpaper(id: string) {
      applyWallpaper(id);
      localStorage.setItem("portfolio-wallpaper", id);
    },
    nextWallpaper() {
      const ids = Object.keys(wallpapers);
      const current = localStorage.getItem("portfolio-wallpaper") || ids[0];
      const next = ids[(ids.indexOf(current) + 1) % ids.length];
      desktopSettings.setWallpaper(next);
      return next;
    },
  };
  (window as any).desktopSettings = desktopSettings;

  // Poblar grid de fondos
  const grid = document.getElementById("wallpaper-grid");
  Object.entries(wallpapers).forEach(([id, bg]) => {
    const swatch = document.createElement("button");
    swatch.className = "wallpaper-swatch";
    swatch.dataset.wallpaper = id;
    swatch.title = id;
    swatch.style.background = bg;
    swatch.addEventListener("click", () => desktopSettings.setWallpaper(id));
    grid?.appendChild(swatch);
  });

  // Estado inicial
  applyWallpaper(localStorage.getItem("portfolio-wallpaper") || "jammy");
  markTheme(desktopSettings.getTheme());

  document.querySelectorAll(".theme-option").forEach((btn) => {
    btn.addEventListener("click", () =>
      desktopSettings.setTheme((btn as HTMLElement).dataset.theme as "light" | "dark"),
    );
  });

  // Navegación del sidebar
  document.querySelectorAll(".settings-nav").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".settings-nav").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const panel = (btn as HTMLElement).dataset.panel;
      document.querySelectorAll(".settings-panel").forEach((p) => {
        p.classList.toggle("hidden", p.id !== `panel-${panel}`);
      });
    });
  });
</script>
